# AuditGlimmer backend configuration. Copy to your shell env; never commit real values.
# demo = fixture providers on bundled synthetic images (zero cost). live = Meta Model API.
AUDITGLIMMER_MODE=demo
# Meta Model API key (https://dev.meta.ai). Required for live mode. Never printed or returned by the API.
MODEL_API_KEY=
# Set to 1 only after reading docs/cost-control.md. Without it, live runs return 403.
AUDITGLIMMER_LIVE_APPROVED=0
# Per-run live caps (requests / estimated USD).
AUDITGLIMMER_MAX_LIVE_REQUESTS_PER_RUN=40
AUDITGLIMMER_MAX_LIVE_USD_PER_RUN=0.50
# Optional overrides
# AUDITGLIMMER_DATA_DIR=backend/data
# AUDITGLIMMER_DATABASE_URL=sqlite:///backend/data/auditglimmer.db
# Frontend: NEXT_PUBLIC_API_BASE=http://localhost:8000  (see frontend/.env.example)
