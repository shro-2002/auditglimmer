# AuditGlimmer — shared/hosted DEMO environment template. Copy, fill, never commit the filled file.
AUDITGLIMMER_MODE=demo
AUDITGLIMMER_LIVE_APPROVED=0
# MODEL_API_KEY must NOT be set in any shared or hosted environment.
# Required whenever the API is reachable beyond localhost (>= 24 chars):
AUDITGLIMMER_ACCESS_CODE=
# Comma-separated frontend origin(s):
AUDITGLIMMER_CORS_ORIGINS=http://localhost:3000
# Frontend (build-time, public — no secrets):
NEXT_PUBLIC_API_BASE=http://localhost:8000
